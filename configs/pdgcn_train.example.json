{
  "monitoring": { "enabled": true },
  "supervision": {
    "enabled": false,
    "temperature_dataset": "fem/temperature",
    "valid_mask_dataset": "fem/valid_mask",
    "lambda_temperature": 0.3,
    "lambda_rollout_temperature": 0.3,
    "rollout_window": null,
    "mode": "rollout"
  },
  "outputs": {
    "checkpoint_path": "../runs/pdgcn/checkpoint.pt",
    "history_path": "../runs/pdgcn/history.json"
  },
  "datasets": [
    {
      "name": "case1",
      "h5_dir": "../../autodl-tmp/case_superrise_compressed",
      "cache_dir": "../runs/pdgcn/cache/case1",
      "scale": {
        "L0": 0.051764991760253906,
        "v0": 0.08,
        "T_amb": 120,
        "delta_T0": 230,
        "Q0": 465000.0,
        "K0": 5.9,
        "rho": 1575,
        "Cp": 1600.0,
        "heat_source_effective_thickness": 0.00015,
