    "training": {
      "lr": 0.0001,
      "lr_scheduler": "warmup_cosine",
      "min_lr": 0.0000001,
      "lr_warmup_epochs": 30,
      "lr_patience": 10,
      "lr_factor": 0.5,
      "epochs": 800,
      "tbptt_window": 5,
      "warmup_steps": 20,
      "grad_clip_norm": null,
      "resume_from_checkpoint": false,
      "resume_checkpoint_path": null,
      "resume_optimizer_state": false,
      "loss_threshold": 0.1,
      "device": null
    }
  }
