# 参考资料目录：本地可读，但不纳入当前仓库跟踪。
/PIGNN/
/DesignPlan/

# Python 字节码和运行时缓存。
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Python 构建和打包产物。
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# 虚拟环境和本地环境变量文件。
.venv/
venv/
env/
ENV/
.env
.env.*

# IDE 和操作系统元数据。
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
Desktop.ini

# 日志、临时文件和训练输出。
*.log
*.tmp
*.temp
tmp/
temp/
checkpoint/
checkpoints/
runs/
outputs/
wandb/

# 实验过程中生成的模型和数据二进制文件。
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.npz
